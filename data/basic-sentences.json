            { "ko": "언제예요?", "rom": "eon-je-ye-yo?", "ro": "Când e?", "en": "When is it?" },
            { "ko": "왜요?", "rom": "wae-yo?", "ro": "De ce?", "en": "Why?" },
            { "ko": "어떻게 해요?", "rom": "eo-tteo-ke hae-yo?", "ro": "Cum se face?", "en": "How do you do it?" }
          ]
        },
