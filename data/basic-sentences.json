    },
    {
      "id": "ch2",
      "num": 2,
      "ro": "Despre mine",
      "en": "About me",
      "info": {
        "title": { "ro": "Ordinea cuvintelor", "en": "Word order" },
        "ro": "În coreeană verbul stă mereu la final: subiect + obiect + verb. „Eu coreeană învăț” = 저는 한국어를 공부해요. Particulele arată rolul cuvântului: 은/는 marchează tema (despre cine vorbim), 이/가 subiectul, 을/를 obiectul. Subiectul se omite des când e clar din context.",
        "en": "In Korean the verb always comes last: subject + object + verb. \"I Korean study\" = 저는 한국어를 공부해요. Particles mark each word's role: 은/는 the topic, 이/가 the subject, 을/를 the object. The subject is often dropped when it's clear from context."
      },
      "units": [
        {
          "id": "introducing",
          "ro": "Mă prezint",
          "en": "Introducing myself",
          "items": [
            { "ko": "제 이름은 마리아예요.", "rom": "je i-reu-meun ma-ri-a-ye-yo", "ro": "Numele meu este Maria.", "en": "My name is Maria." },
            { "ko": "루마니아 사람이에요.", "rom": "ru-ma-ni-a sa-ra-mi-e-yo", "ro": "Sunt român(că).", "en": "I'm Romanian." },
            { "ko": "루마니아에서 왔어요.", "rom": "ru-ma-ni-a-e-seo wa-sseo-yo", "ro": "Vin din România.", "en": "I'm from Romania." },
            { "ko": "부쿠레슈티에 살아요.", "rom": "bu-ku-re-syu-ti-e sa-ra-yo", "ro": "Locuiesc în București.", "en": "I live in Bucharest." },
            { "ko": "스물다섯 살이에요.", "rom": "seu-mul-da-seot sa-ri-e-yo", "ro": "Am douăzeci și cinci de ani.", "en": "I'm twenty-five.", "tip": { "ro": "Vârsta se spune cu numerele coreene native (하나, 둘, 셋…) + 살.", "en": "Age uses native Korean numbers (하나, 둘, 셋…) + 살." } },
            { "ko": "저는 학생이에요.", "rom": "jeo-neun hak-saeng-i-e-yo", "ro": "Sunt student(ă).", "en": "I'm a student." },
            { "ko": "회사에 다녀요.", "rom": "hoe-sa-e da-nyeo-yo", "ro": "Lucrez la o firmă.", "en": "I work at a company." },
            { "ko": "취미는 독서예요.", "rom": "chwi-mi-neun dok-seo-ye-yo", "ro": "Hobby-ul meu e cititul.", "en": "My hobby is reading." }
          ]
        },
        {
          "id": "language",
          "ro": "Despre limbă",
          "en": "About the language",
          "items": [
            { "ko": "한국어를 조금 해요.", "rom": "han-gu-geo-reul jo-geum hae-yo", "ro": "Vorbesc puțină coreeană.", "en": "I speak a little Korean." },
            { "ko": "한국어를 공부하고 있어요.", "rom": "han-gu-geo-reul gong-bu-ha-go i-sseo-yo", "ro": "Învăț coreeană.", "en": "I'm studying Korean." },
            { "ko": "다시 한번 말해 주세요.", "rom": "da-si han-beon mal-hae ju-se-yo", "ro": "Mai spuneți o dată, vă rog.", "en": "Please say that again." },
            { "ko": "천천히 말해 주세요.", "rom": "cheon-cheon-hi mal-hae ju-se-yo", "ro": "Vorbiți mai rar, vă rog.", "en": "Please speak slowly." },
            { "ko": "이게 한국어로 뭐예요?", "rom": "i-ge han-gu-geo-ro mwo-ye-yo?", "ro": "Cum se spune asta în coreeană?", "en": "What's this in Korean?" },
            { "ko": "무슨 뜻이에요?", "rom": "mu-seun tteu-si-e-yo?", "ro": "Ce înseamnă?", "en": "What does it mean?" },
