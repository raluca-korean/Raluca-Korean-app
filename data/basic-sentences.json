            { "ko": "그래요?", "rom": "geu-rae-yo?", "ro": "Da? / Așa e?", "en": "Is that so?" },
            { "ko": "물론이죠.", "rom": "mul-lo-ni-jyo", "ro": "Desigur.", "en": "Of course." }
          ]
        }
