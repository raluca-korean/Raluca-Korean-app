          "en": "How I feel",
          "items": [
            { "ko": "기분이 좋아요.", "rom": "gi-bu-ni jo-a-yo", "ro": "Sunt bine dispus(ă).", "en": "I'm in a good mood." },
            { "ko": "피곤해요.", "rom": "pi-gon-hae-yo", "ro": "Sunt obosit(ă).", "en": "I'm tired." },
