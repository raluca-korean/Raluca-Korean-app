{
  "chapters": [
    {
      "id": "ch1",
      "num": 1,
      "ro": "Comunicare de bază",
      "en": "Communication basics",
      "info": {
        "title": { "ro": "Două registre politicoase", "en": "Two polite registers" },
        "ro": "Coreeana schimbă finalul verbului după cât de politicos vrei să fii. Terminația -요 (해요) e politicoasă și prietenoasă, potrivită aproape oriunde. Terminația -ㅂ니다 / -습니다 (합니다) e formală: o auzi în magazine, la știri, la serviciu sau când vorbești cu cineva mult mai în vârstă. Fără -요 (잘 자) vorbești familiar, doar cu prieteni apropiați sau cu cei mai mici.",
        "en": "Korean changes the verb ending depending on how polite you want to be. The -요 ending (해요) is polite and friendly and fits almost anywhere. The -ㅂ니다 / -습니다 ending (합니다) is formal: you hear it in shops, on the news, at work, or with someone much older. Without -요 (잘 자) the speech is casual, only for close friends or people younger than you."
      },
      "units": [
        {
          "id": "first-meetings-1",
          "ro": "Prima întâlnire ①",
          "en": "First meetings ①",
          "items": [
            { "ko": "안녕하세요.", "rom": "an-nyeong-ha-se-yo", "ro": "Bună ziua. / Salut.", "en": "Hello. / Hi.", "tip": { "ro": "Merge la orice oră din zi. Între prieteni apropiați ajunge 안녕.", "en": "Works at any time of day. Between close friends, 안녕 is enough." } },
            { "ko": "처음 뵙겠습니다.", "rom": "cheo-eum boep-get-sseum-ni-da", "ro": "Încântat de cunoștință. (formal, la prima întâlnire)", "en": "How do you do?" },
            { "ko": "저는 김지나입니다.", "rom": "jeo-neun gim-ji-na-im-ni-da", "ro": "Eu sunt Kim Ji-na.", "en": "I'm Ji-na Kim.", "tip": { "ro": "Când îți spui numele în Coreea, spui întâi numele de familie.", "en": "When you say your name in Korea, give your family name first." } },
            { "ko": "초면인 것 같네요.", "rom": "cho-myeo-nin geot gat-ne-yo", "ro": "Cred că nu ne-am mai întâlnit.", "en": "I don't think we've met." },
            { "ko": "만나서 반가워요.", "rom": "man-na-seo ban-ga-wo-yo", "ro": "Mă bucur să te cunosc.", "en": "Nice to meet you." },
            { "ko": "저도 반갑습니다.", "rom": "jeo-do ban-gap-sseum-ni-da", "ro": "Și eu mă bucur.", "en": "Nice to meet you too." },
            { "ko": "만나 뵙게 되어 영광입니다.", "rom": "man-na boep-ge doe-eo yeong-gwang-im-ni-da", "ro": "Este o onoare să vă cunosc.", "en": "I'm honored to meet you." }
          ]
        },
        {
          "id": "first-meetings-2",
          "ro": "Prima întâlnire ②",
          "en": "First meetings ②",
          "items": [
            { "ko": "말씀 많이 들었어요.", "rom": "mal-sseum ma-ni deu-reo-sseo-yo", "ro": "Am auzit multe despre dumneavoastră.", "en": "I've heard so much about you." },
            { "ko": "성희 씨, 김준호 씨 아세요?", "rom": "seong-hi ssi, gim-jun-ho ssi a-se-yo?", "ro": "Seong-hee, îl cunoști pe Kim Jun-ho?", "en": "Seong-hee, have you met Jun-ho Kim?", "tip": { "ro": "씨 se pune după nume, ca un „domnul/doamna” prietenos. Nu-l folosi niciodată cu propriul nume.", "en": "씨 goes after a name, like a friendly Mr./Ms. Never use it with your own name." } },
            { "ko": "박진수라고 합니다.", "rom": "bak-jin-su-ra-go ham-ni-da", "ro": "Mă numesc Park Jin-su.", "en": "My name is Jin-su Park." },
            { "ko": "김준호 씨의 친구입니다.", "rom": "gim-jun-ho ssi-e chin-gu-im-ni-da", "ro": "Sunt prietenul lui Kim Jun-ho.", "en": "I'm a friend of Jun-ho Kim.", "tip": { "ro": "의 (al, a, ai) se pronunță de obicei „e” în vorbire.", "en": "The possessive 의 is usually pronounced \"e\" in speech." } },
            { "ko": "전에 우리 만난 적 있나요?", "rom": "jeo-ne u-ri man-nan jeok in-na-yo?", "ro": "Ne-am mai întâlnit înainte?", "en": "Have we ever met before?", "tip": { "ro": "-(으)ㄴ 적 있다 = „a mai face ceva vreodată”.", "en": "-(으)ㄴ 적 있다 means \"to have ever done something\"." } },
            { "ko": "명함 있으세요?", "rom": "myeong-ham i-sseu-se-yo?", "ro": "Aveți o carte de vizită?", "en": "May I have your business card?" },
            { "ko": "제 명함입니다.", "rom": "je myeong-ha-mim-ni-da", "ro": "Aceasta e cartea mea de vizită.", "en": "Here's my card.", "tip": { "ro": "Cartea de vizită se dă și se primește cu ambele mâini.", "en": "Give and receive business cards with both hands." } }
          ]
        },
        {
          "id": "situational-greetings",
          "ro": "Salutări de zi cu zi",
          "en": "Situational greetings",
          "items": [
            { "ko": "좋은 아침이에요.", "rom": "jo-eun a-chi-mi-e-yo", "ro": "Bună dimineața.", "en": "Good morning." },
            { "ko": "잘 잤어요?", "rom": "jal ja-sseo-yo?", "ro": "Ai dormit bine?", "en": "Did you sleep well?" },
            { "ko": "안녕히 주무셨어요?", "rom": "an-nyeong-hi ju-mu-syeo-sseo-yo?", "ro": "Ați dormit bine? (politicos, către cei mai în vârstă)", "en": "Did you sleep well? (to elders)" },
            { "ko": "잘 자요.", "rom": "jal ja-yo", "ro": "Noapte bună.", "en": "Good night." },
            { "ko": "안녕히 주무세요.", "rom": "an-nyeong-hi ju-mu-se-yo", "ro": "Noapte bună. (politicos)", "en": "Good night. (polite)" },
            { "ko": "잘 먹겠습니다.", "rom": "jal meok-get-sseum-ni-da", "ro": "Poftă bună! / Mulțumesc pentru masă. (înainte de masă)", "en": "Thanks for the food. (before eating)", "tip": { "ro": "Se spune înainte de masă, ca să mulțumești gazdei sau mamei.", "en": "Say it before a meal to thank the host or your mother." } },
            { "ko": "잘 먹었습니다.", "rom": "jal meo-geot-sseum-ni-da", "ro": "A fost foarte bun, mulțumesc. (după masă)", "en": "I enjoyed it. (after eating)", "tip": { "ro": "Se spune după masă, tot ca mulțumire.", "en": "Say it after the meal, also to thank them." } }
          ]
        },
        {
          "id": "goodbyes",
          "ro": "La despărțire",
          "en": "Saying goodbye",
          "items": [
            { "ko": "안녕히 가세요.", "rom": "an-nyeong-hi ga-se-yo", "ro": "La revedere. (către cel care pleacă)", "en": "Goodbye. (to someone leaving)", "tip": { "ro": "Literal „mergi în pace”. O spui celui care pleacă.", "en": "Literally \"go in peace\". Say it to the person who is leaving." } },
            { "ko": "안녕히 계세요.", "rom": "an-nyeong-hi gye-se-yo", "ro": "La revedere. (către cel care rămâne)", "en": "Goodbye. (to someone staying)", "tip": { "ro": "Literal „rămâi în pace”. O spui când tu pleci, iar celălalt rămâne.", "en": "Literally \"stay in peace\". Say it when you leave and they stay." } },
            { "ko": "또 만나요.", "rom": "tto man-na-yo", "ro": "Ne mai vedem.", "en": "See you again." },
            { "ko": "내일 봐요.", "rom": "nae-il bwa-yo", "ro": "Ne vedem mâine.", "en": "See you tomorrow." },
            { "ko": "조심히 가세요.", "rom": "jo-sim-hi ga-se-yo", "ro": "Drum bun! / Ai grijă pe drum.", "en": "Get home safe." },
            { "ko": "연락할게요.", "rom": "yeol-la-kal-ge-yo", "ro": "Te contactez eu.", "en": "I'll be in touch." },
            { "ko": "주말 잘 보내세요.", "rom": "ju-mal jal bo-nae-se-yo", "ro": "Weekend plăcut!", "en": "Have a nice weekend." }
          ]
        },
        {
          "id": "thanks-sorry",
          "ro": "Mulțumiri și scuze",
          "en": "Thanks and apologies",
          "items": [
            { "ko": "감사합니다.", "rom": "gam-sa-ham-ni-da", "ro": "Vă mulțumesc.", "en": "Thank you." },
            { "ko": "고마워요.", "rom": "go-ma-wo-yo", "ro": "Mulțumesc.", "en": "Thanks." },
            { "ko": "천만에요.", "rom": "cheon-ma-ne-yo", "ro": "Cu plăcere.", "en": "You're welcome." },
            { "ko": "아니에요.", "rom": "a-ni-e-yo", "ro": "Nu ai pentru ce.", "en": "Not at all.", "tip": { "ro": "Cel mai natural răspuns la „mulțumesc” în vorbirea de zi cu zi.", "en": "The most natural reply to \"thank you\" in everyday speech." } },
            { "ko": "죄송합니다.", "rom": "joe-song-ham-ni-da", "ro": "Îmi cer scuze.", "en": "I'm sorry. (formal)" },
            { "ko": "미안해요.", "rom": "mi-an-hae-yo", "ro": "Îmi pare rău.", "en": "I'm sorry." },
            { "ko": "괜찮아요.", "rom": "gwaen-cha-na-yo", "ro": "Nu-i nimic. / E în regulă.", "en": "It's okay." },
            { "ko": "실례합니다.", "rom": "sil-lye-ham-ni-da", "ro": "Mă scuzați. (ca să atragi atenția)", "en": "Excuse me.", "tip": { "ro": "Se folosește când treci printre oameni sau vrei să întrebi ceva un necunoscut.", "en": "Use it to get past people or to ask a stranger something." } }
          ]
        },
        {
